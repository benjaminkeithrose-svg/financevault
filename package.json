{
  "name": "financevault",
  "private": true,
  "version": "1.16.0",
  "description": "Private Australian personal financial management & document system",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:seed": "npm run prisma:seed --workspace server",
    "test": "npm test --workspace server",
    "release": "node scripts/make-release.mjs",
    "release:windows": "node desktop/build.mjs --win",
    "start": "node launcher/launch.mjs"
  }
}
